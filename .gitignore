# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local secrets — never commit real credentials
Supabase_Cloudflare_Info.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local pre-migration DB backups — never commit
/.backups/

# Local copies of photos from Google Drive, for testing; uploaded through the admin.
/Test Photos/

# End-to-end tests (tests/e2e): the saved studio sign-in (a live session
# cookie, never commit it) and screenshots / generated test images.
/tests/e2e/.auth/
/tests/e2e/.output/
