{
  "name": "hamlet-visuals",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#src/*": {
      "types": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "payload migrate --disable-transpile && next build",
    "start": "next start",
    "lint": "eslint",
    "payload": "payload --disable-transpile",
    "test:e2e": "node tests/e2e/run.cjs",
    "test:e2e:login": "node tests/e2e/login.cjs",
    "test:unit": "node --experimental-strip-types --no-warnings --test \"tests/unit/*.test.mts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@payloadcms/db-postgres": "^3.89.0",
    "@payloadcms/email-resend": "^3.89.0",
    "@payloadcms/live-preview": "^3.89.0",
    "@payloadcms/live-preview-react": "^3.89.0",
    "@payloadcms/next": "^3.89.0",
    "@payloadcms/richtext-lexical": "^3.89.0",
    "@payloadcms/storage-s3": "^3.89.0",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^21.3.4",
    "graphql": "^16.14.2",
    "next": "16.3.4",
    "payload": "^3.89.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
